# ============================================================
# 18. WAVE PACKET
# ============================================================

def wave_packet(
    x,
    center,
    width,
    amplitude
):

    return (
        amplitude
        *
        np.exp(
            -(
                (x - center)
                /
                width
            ) ** 2
        )
    )


