    surface_reflection.set_data([], [])

    transmitted_wave.set_data([], [])

    bottom_reflection.set_data([], [])

    return_wave.set_data([], [])

    status_text.set_text(
        "Waiting for source..."
    )

    time_text.set_text(
        "Time = 0.000 ms"
    )

    return (
        incident_wave,
        surface_reflection,
        transmitted_wave,
        bottom_reflection,
        return_wave,
        status_text,
        time_text
    )


# ============================================================
# 20. UPDATE ANIMATION
# ============================================================

def update(frame):

    current_time = animation_times[frame]


    # Clear waves
    incident_wave.set_data([], [])

    surface_reflection.set_data([], [])

    transmitted_wave.set_data([], [])

    bottom_reflection.set_data([], [])

    return_wave.set_data([], [])


    # ========================================================
    # PHASE 1
    # SOURCE
    # ========================================================

    if current_time < SOURCE_TIME:

        status = (
            "SOURCE + SENSOR\n"
            "Waiting to emit acoustic pulse"
        )


    # ========================================================
    # PHASE 2
    # SOURCE -> SURFACE
    # ========================================================

    elif current_time < SURFACE_TIME:

        distance = (
            AIR_SPEED
            *
            (
                current_time
                -
                SOURCE_TIME
            )
        )


        center = min(
            distance,
            AIR_DISTANCE
        )


        x = np.linspace(
            max(
                0,
                center - 0.10
            ),
            min(
                AIR_DISTANCE,
                center + 0.10
            ),
            300
        )


        y = wave_packet(
            x,
            center,
            0.025,
            0.85
        )


        incident_wave.set_data(
            x,
            y
        )


        status = (
            "INCIDENT WAVE\n"
            "Sound travels through AIR\n"
            "towards the liquid surface"
        )


    # ========================================================
    # PHASE 3
    # SURFACE REFLECTION + TRANSMISSION
    # ========================================================

    elif current_time < BOTTOM_TIME:

        # ----------------------------------------------------
        # Surface reflected wave
        # ----------------------------------------------------

        reflected_elapsed = (
            current_time -
            SURFACE_TIME
        )


        reflected_distance = (
            AIR_SPEED *
            reflected_elapsed
        )


        reflected_center = max(
            0,
            AIR_DISTANCE -
            reflected_distance
        )


        xr = np.linspace(
            max(
                0,
                reflected_center - 0.10
            ),
            min(
                AIR_DISTANCE,
                reflected_center + 0.10
            ),
            250
        )


        yr = wave_packet(
            xr,
            reflected_center,
            0.025,
            -0.55
        )


        surface_reflection.set_data(
            xr,
            yr
        )


        # ----------------------------------------------------
        # Transmitted wave in liquid
        # ----------------------------------------------------

        liquid_elapsed = (
            current_time -
            SURFACE_TIME
        )


        liquid_distance = (
            LIQUID_SPEED *
            liquid_elapsed
        )


        liquid_distance = min(
            liquid_distance,
            LIQUID_DEPTH
        )


        transmitted_center = (
            AIR_DISTANCE
            +
            liquid_distance
        )


        xt = np.linspace(
            max(
                AIR_DISTANCE,
                transmitted_center - 0.10
            ),
            min(
                BOTTOM_POSITION,
                transmitted_center + 0.10
            ),
            250
        )


        yt = wave_packet(
            xt,
            transmitted_center,
            0.025,
            0.30
        )


        transmitted_wave.set_data(
            xt,
            yt
        )


        status = (
            "AIR-LIQUID INTERFACE\n"
            "Part of the wave is REFLECTED\n"
            "Part is TRANSMITTED into LIQUID"
        )


    # ========================================================
    # PHASE 4
    # BOTTOM REFLECTION
    # ========================================================

    else:

        # Time since bottom reflection
        elapsed = (
            current_time -
            BOTTOM_TIME
        )


        # Time required for reflected wave
        # to travel from bottom to surface
        liquid_return_time = (
            LIQUID_DEPTH /
            LIQUID_SPEED
        )


        # ----------------------------------------------------
        # BOTTOM -> SURFACE
        # ----------------------------------------------------

        if elapsed < liquid_return_time:

            distance_from_bottom = (
                LIQUID_SPEED *
                elapsed
            )


            center = max(
                AIR_DISTANCE,
                BOTTOM_POSITION -
                distance_from_bottom
            )


            x = np.linspace(
                max(
                    AIR_DISTANCE,
                    center - 0.10
                ),
                min(
                    BOTTOM_POSITION,
                    center + 0.10
                ),
                300
            )


            y = wave_packet(
                x,
                center,
                0.025,
                0.25
            )


            bottom_reflection.set_data(
                x,
                y
            )


            status = (
                "BOTTOM REFLECTION\n"
                "Wave has reached the liquid bottom\n"
                "and is travelling upward"
            )


        # ----------------------------------------------------
        # SURFACE -> SENSOR
        # ----------------------------------------------------

        else:

            air_start_time = (
                BOTTOM_TIME
                +
                liquid_return_time
            )


            air_elapsed = (
                current_time -
                air_start_time
            )


            air_distance_back = (
                AIR_SPEED *
                air_elapsed
            )


            center = max(
                0,
                AIR_DISTANCE -
                air_distance_back
            )


            x = np.linspace(
                max(
                    0,
                    center - 0.10
                ),
                min(
                    AIR_DISTANCE,
                    center + 0.10
                ),
                300
            )


            y = wave_packet(
                x,
                center,
                0.025,
                0.20
            )


            return_wave.set_data(
                x,
                y
            )


            status = (
                "RETURN TO SENSOR\n"
                "Bottom-reflected wave travels back\n"
                "through the liquid and air"
            )


    # ========================================================
    # UPDATE TIME
    # ========================================================

    time_text.set_text(
        f"Time = "
        f"{current_time * 1000:.3f} ms"
    )


    status_text.set_text(
        status
    )


    return (
        incident_wave,
        surface_reflection,
        transmitted_wave,
        bottom_reflection,
        return_wave,
        status_text,
        time_text
    )


